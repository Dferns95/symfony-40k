// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs


Table users {
  id integer [primary key]
  username varchar
  role varchar
  created_at timestamp
}

Table armies {
  id integer [primary key]
  name varchar
  description varchar
  rule varchar
}

Table datasheets {
  id integer [primary key]
  army_id integer [not null, ref: >armies.id]
  name varchar
  base varchar
  move integer
  tough integer
  save integer
  insv integer [null]
  wound integer
  ld integer
  oc integer
  unit_composition varchar
}

Table datasheet_abilities {
  id integer [primary key]
  name varchar
  rule varchar
}
Table datasheet_datasheet_abilities {
  datasheet_id integer [not null, ref: > datasheets.id]
  datasheet_ability_id integer [not null, ref: > datasheet_abilities.id]
}
Table datasheet_ability_subrule {
  id integer [primary key]
  datasheet_ability_id integer [not null, ref: > datasheet_abilities.id]
  name varchar
  rule varchar
}


Table core_abilities {
  id integer [primary key]
  name varchar
  rule varchar
}
Table datasheet_core_abilities{
  datasheet_id integer [not null, ref: > datasheets.id]
  core_ability_id integer [not null, ref: > core_abilities.id]
}


Table weapons {
  id integer [primary key]
  name varchar
  type weapon_type
  attacks varchar
  bs_ws integer [null]
  strength integer
  ap integer
  damage integer
}
Table datasheet_weapons{
  datasheet_id integer [not null, ref: > datasheets.id]
  weapons integer [not null, ref: >weapons.id]
}

Table weapon_abilities{
  id integer [primary key]
  name varchar
  rule varchar
}
Table weapon_weapon_abilties{
  weapon_id integer [not null, ref: > weapons.id]  
  weapon_ability_id integer [not null, ref: > weapon_abilities.id]
}

Table datasheet_composition {
  id integer [primary key]
  datasheet_id integer [not null, ref: > datasheets.id]
  model_id integer [not null, ref: > models.id]

  min_quantity integer
  max_quantity integer
}
Table models {
  id integer [primary key]
  name varchar
}
Table wargear_loadouts{
    id integer [primary key]
    datasheet_id integer [not null, ref: > datasheets.id]
    description varchar
}
Table wargear_loadout_model_weapons{
    wargear_loadout_id integer [not null, ref: > wargear_loadouts.id]
    weapon_id integer [not null, ref: > weapons.id]
    model_id integer [not null, ref: > models.id]
    count integer
}

Table wargear_costs{
  id integer [primary key]
  datasheet_id integer [not null, ref: > datasheets.id]
  weapon_id integer [not null, ref: > weapons.id]
  
  points integer
}
Table datasheet_costs {
  id integer [primary key]
  datasheets_id integer [not null, ref: > datasheets.id]

  model_count integer
  points integer [not null]
}

Table datasheet_keyword {
  id integer [primary key]
  datasheet_id integer [not null, ref: > datasheets.id]
  name varchar
}
Table datasheet_datasheet_keywords {
  datasheet_id integer [not null, ref: > datasheets.id]
  datasheet_keyword_id integer [not null, ref: > datasheet_keyword.id]
}

Table detachments {
  id integer [primary key]
  name varchar
  rule varchar
  points integer
  force_disposition force_disposition
}
Table enhancements {
  id integer [primary key]
  name varchar
  rule varchar
  points integer
}
Table army_list_detachements {
  army_list_id integer [not null, ref: > army_list.id]
  detachment_id integer [not null, ref: > detachments.id]
}

Table army_list {
  id integer [primary key]
  user_id integer [not null, ref: > users.id]
  army_id integer [not null, ref: > armies.id]
  name varchar
  points integer
}
Table army_list_units {
  id integer [primary key]
  army_list_id integer [not null, ref: > army_list.id]
  datasheet_id integer [not null, ref: > datasheets.id]
  points integer
}


Enum weapon_type{
  ranged
  melee
}

Enum force_disposition{
  disruption
  priority_assets
  Take_and_hold
  Purge_the_foe
  reconnaissance
}